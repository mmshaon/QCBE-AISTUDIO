{
  "name": "qcbe-aistudio",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo scaffold for QCBE-AISTUDIO",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "pnpm install",
    "build": "pnpm -w -r build",
    "lint": "pnpm -w -r lint",
    "test": "pnpm -w -r test",
    "start": "echo \"Run packages individually: cd packages/api && pnpm start; cd packages/ui && pnpm dev\""
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "eslint": "^8.50.0",
    "prettier": "^2.9.0"
  }
}
